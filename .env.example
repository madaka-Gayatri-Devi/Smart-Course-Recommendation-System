# ==============================================================================
# SmartLearn Backend Environment Configuration Example
# Copy this file to '.env' and fill in your actual environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database configuration
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///smartlearn.db

# ------------------------------------------------------------------------------
# JWT/authentication configuration
# ------------------------------------------------------------------------------
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Email / SMTP Notification configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=SmartLearn <noreply@smartlearn.edu>
SMTP_TLS=true
INACTIVITY_THRESHOLD_DAYS=3
REMINDER_COOLDOWN_DAYS=7

# ------------------------------------------------------------------------------
# Firebase / Google Auth configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain

# ------------------------------------------------------------------------------
# Razorpay TEST MODE configuration
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# Other required SmartLearn backend configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# AI Chatbot Assistant Configuration (Gemini / OpenAI / Groq / Anthropic)
# ------------------------------------------------------------------------------
# Set preferred AI provider ('groq', 'gemini', 'openai', or 'anthropic').
# If preferred provider fails or hits quota, the system automatically falls back.
AI_PROVIDER=groq

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=your_anthropic_api_key_here