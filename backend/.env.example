# ==============================================================================
# SmartLearn Backend Environment Configuration Example
# Copy this file to '.env' and fill in your actual environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database configuration
# ------------------------------------------------------------------------------
# For local development with SQLite (default):
DATABASE_URL=sqlite:///smartlearn.db

# For production deployment on Render with PostgreSQL:
# Render automatically injects this when linked to a Render PostgreSQL service:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ------------------------------------------------------------------------------
# JWT/authentication configuration
# ------------------------------------------------------------------------------
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Application URL (Production or Local)
# ------------------------------------------------------------------------------
APP_URL=https://smart-course-recommendation-system.onrender.com

# ------------------------------------------------------------------------------
# Firebase / Google Authentication configuration
# ------------------------------------------------------------------------------
# Found in Firebase Console > Project Settings > General > Your Apps > Web App
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# (Optional) Direct Google Cloud OAuth 2.0 Credentials
# Found in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# Email / SMTP Notification configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=SmartLearn <noreply@smartlearn.edu>
SMTP_TLS=true
INACTIVITY_THRESHOLD_DAYS=3
REMINDER_COOLDOWN_DAYS=7

# ------------------------------------------------------------------------------
# Razorpay TEST MODE configuration
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# Other required SmartLearn backend configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# AI Chatbot Assistant Configuration (Gemini / OpenAI / Groq / Anthropic)
# ------------------------------------------------------------------------------
AI_PROVIDER=groq

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=your_anthropic_api_key_here
